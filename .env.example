# Copy to .env at the repo root (harkers_archive/.env).
# All sub-projects load this file automatically.

# --- sewards_phonograph ---
TELEGRAM_BOT_TOKEN=
SAVE_DIR=/absolute/path/to/harkers_archive/voice_archive
# Optional; defaults to sibling transcripts/ next to SAVE_DIR
# TRANSCRIPTS_DIR=/absolute/path/to/harkers_archive/transcripts

# --- mina_typewriter (OpenAI Audio API) ---
# OPENAI_API_KEY is required for transcription (see rainfields_mind below).
# MINA_TRANSCRIBE_MODEL=whisper-1
# Defaults: voice_archive/ → transcripts/
# HARKERS_INPUT_DIR=/absolute/path/to/harkers_archive/voice_archive
# HARKERS_OUTPUT_DIR=/absolute/path/to/harkers_archive/transcripts

# --- van_helsings_dossier (optional overrides) ---
# Defaults: transcripts/ → dossier/
# HARKERS_TRANSCRIPTS_DIR=/absolute/path/to/harkers_archive/transcripts
# HARKERS_DOSSIER_DIR=/absolute/path/to/harkers_archive/dossier

# --- helsings_round.py ---
# Seconds between transcription checks when voice files are waiting (default: 60)
# TRANSCRIBE_PENDING_POLL_SECONDS=60
# Full coordinator pass backstop when idle (minutes; default: 1440)
# TRANSCRIBE_INTERVAL_MINUTES=1440
# Van Helsing's Dossier: compile on new voice transcripts or every N minutes (default: 1440)
# DOSSIER_INTERVAL_MINUTES=1440
# DOSSIER_ENABLED=true
# RAINFIELDS_ENABLED=true
# Notify archive users when helsings_round starts (default: true)
# STARTUP_NOTIFY_ENABLED=true
# Optional; defaults to helsings_round_http.log in the repo root
# HELSINGS_HTTP_LOG=/absolute/path/to/helsings_round_http.log

# --- rainfields_mind (weekly synthesis agent) ---
OPENAI_API_KEY=
# OpenRouter: use your OpenRouter key and base URL
# OPENAI_API_BASE=https://openrouter.ai/api/v1
# RAINFIELDS_MODEL=google/gemini-2.5-flash
# Omit RAINFIELDS_TEMPERATURE for reasoning models (o-series) that only allow default
# RAINFIELDS_TEMPERATURE=0
# HARKERS_RAINFIELDS_DIR=/absolute/path/to/harkers_archive/rainfields_mind
# RAINFIELDS_TIMEZONE=America/Fortaleza

# --- Docker (VPS) ---
# docker compose up -d --build
# Archive folders (voice_archive, transcripts, dossier, logs, rainfields_mind) are bind-mounted
# to the host next to this repo. Secrets stay in .env — never commit.
