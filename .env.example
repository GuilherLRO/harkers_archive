# Copy to .env at the repo root (harkers_archive/.env).
# All sub-projects load this file automatically.

# --- sewards_phonograph ---
TELEGRAM_BOT_TOKEN=
SAVE_DIR=/absolute/path/to/harkers_archive/voice_archive
# Optional; defaults to sibling transcripts/ next to SAVE_DIR
# TRANSCRIPTS_DIR=/absolute/path/to/harkers_archive/transcripts

# --- mina_typewriter (optional overrides) ---
# Defaults: voice_archive/ → transcripts/
# HARKERS_INPUT_DIR=/absolute/path/to/harkers_archive/voice_archive
# HARKERS_OUTPUT_DIR=/absolute/path/to/harkers_archive/transcripts

# --- helsings_round.py ---
# Minutes between scheduled Mina's Typewriter passes (default: 480)
# TRANSCRIBE_INTERVAL_MINUTES=480
# Optional; defaults to helsings_round_http.log in the repo root
# HELSINGS_HTTP_LOG=/absolute/path/to/helsings_round_http.log
